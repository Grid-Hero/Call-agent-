# ============================================================
#  Call-Agent – Beispielkonfiguration
#  Kopiere diese Datei nach ".env" und trage echte Werte ein.
# ============================================================

# --- Anwendung ---------------------------------------------
APP_BASE_URL=https://dein-server.example.com   # Öffentlich erreichbare URL (für Twilio-Webhooks)
APP_ENV=development                              # development | production
LOG_LEVEL=INFO

# --- Gesprächsmodus ----------------------------------------
# "gather"   -> Turn-by-turn (einfach, robust, kein Streaming)
# "realtime" -> Echtzeit-Audio via Twilio Media Streams (ElevenLabs, optional Deepgram)
CONVERSATION_MODE=gather

# --- Telefonie-Adapter -------------------------------------
# Welcher Anbieter genutzt wird: "twilio" oder "asterisk"
TELEPHONY_PROVIDER=twilio

# Twilio-Zugangsdaten (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+49xxxxxxxxxx                # Eingehende Nummer (oder via Telekom BYOC)
# Twilio-Signaturen der Webhooks prüfen (Sicherheit). In Produktion immer "true".
TWILIO_VALIDATE_SIGNATURE=true

# --- Anthropic Claude --------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
# Sprache der Anrufannahme
AGENT_LANGUAGE=de-DE
AGENT_COMPANY_NAME=Musterfirma GmbH

# --- Stimme (Text-to-Speech) -------------------------------
# "twilio"     -> eingebaute Twilio-Stimme (kostenlos, einfach)
# "elevenlabs" -> natürliche ElevenLabs-Stimme (benötigt Account/Key)
TTS_PROVIDER=twilio
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                              # Voice-ID aus deinem ElevenLabs-Konto
ELEVENLABS_MODEL=eleven_multilingual_v2           # unterstützt Deutsch
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Hinweis: Im Echtzeit-Modus wird automatisch ulaw_8000 gestreamt (Twilio-Format).

# --- Speech-to-Text (nur Echtzeit-Modus) -------------------
# "elevenlabs" -> STT + TTS über EINEN Account (empfohlen, kein Deepgram nötig)
# "deepgram"   -> Alternative (separater Account)
STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_ENCODING=ulaw
# Nur falls STT_PROVIDER=deepgram:
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=de

# --- E-Mail-Versand (SMTP) ---------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=callagent@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=callagent@example.com
EMAIL_FALLBACK_TO=zentrale@example.com           # Wenn kein Mitarbeiter zugeordnet werden kann

# --- Mitarbeiterverzeichnis --------------------------------
DIRECTORY_PATH=config/directory.yaml

# --- Admin-Weboberfläche (/admin) --------------------------
# Frei wählbares Passwort. Leer = Admin-Seite deaktiviert.
ADMIN_PASSWORD=
ADMIN_USER=admin

# --- Dauerhafte Speicherung in GitHub (optional) -----------
# Wenn gesetzt, speichert /admin Änderungen als Commit ins Repo und lädt
# beim Start von dort (überlebt Render-Neustarts, versioniert).
GITHUB_TOKEN=                      # Fine-grained PAT mit "Contents: read & write"
GITHUB_REPO=                       # z.B. Grid-Hero/Call-agent-
GITHUB_BRANCH=main                 # der tatsächlich deployte Branch
GITHUB_CONFIG_PATH=config/directory.yaml
